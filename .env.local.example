# Supabase — Project Settings → API (copie para .env.local com seus valores reais)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Alternativa (legado): NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Upload de imagens no chat (Supabase Storage) — Settings → API → service_role
# NÃO commite nem exponha no frontend (sem prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Legado (não usado mais): Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Desenvolvimento — exibe abas Mapa e Supabase no menu (não usar em produção)
# NEXT_PUBLIC_DEV_NAV=true
