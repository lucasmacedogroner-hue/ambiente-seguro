NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Alternativa (legado): NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Opcional — upload de imagens no chat (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Desenvolvimento — exibe abas Mapa e Supabase no menu (não usar em produção)
# NEXT_PUBLIC_DEV_NAV=true
